{
  "name": "@jayyuen66/dsh-dir-prep-organize",
  "version": "0.1.1",
  "description": "dsh 插件：对话输入框「整理」按钮（主键直接整理/▾ 以角色视角整理，结合当前目录 + session 模型整理优化草稿）+「模板」下拉（内置精选角色集生成自插件 agents/ 角色库，可按部门分组；设置卡可增删改/一键导入内置全部/导入本地角色 .md）",
  "homepage": "https://github.com/JayYuen666/dsh-dir-prep-organize#readme",
  "bugs": {
    "url": "https://github.com/JayYuen666/dsh-dir-prep-organize/issues"
  },
  "license": "MIT",
  "author": "JayYuen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayYuen666/dsh-dir-prep-organize.git"
  },
  "files": [
    "icon.svg",
    "host.js",
    "client.js",
    "templates.data.mjs",
    "types",
    "cordis.patch.yml",
    "agents",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "./host.js",
    "./client.js",
    "./templates.data.mjs"
  ],
  "main": "host.js",
  "types": "./types/host.d.ts",
  "exports": {
    ".": {
      "types": "./types/host.d.ts",
      "default": "./host.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "oxlint .",
    "test": "vitest run --coverage",
    "gen:defaults": "node scripts/gen-defaults.mjs",
    "check": "npm run --loglevel=warn typecheck && npm run --loglevel=warn lint && npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn build:types && npm run --loglevel=warn test && npm run --loglevel=warn fmt:check",
    "build:client": "node build-client.mjs",
    "build": "node build-host.mjs",
    "build:types": "node build-types.mjs",
    "prepack": "npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn build:types",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.6-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@jayyuen66/dsh-plugin-shared": "^0.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "icon": "icon.svg",
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=22.12.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
