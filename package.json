{
  "name": "@jayyuen66/dsh-dir-prep-organize",
  "version": "0.1.7",
  "description": "dsh 插件：对话输入框「润色」按钮（主键直接润色/▾ 以角色风格润色，结合当前目录 + session 模型润色草稿）+「模板」下拉（内置精选角色集生成自插件 agents/ 角色库，可按部门分组；设置卡可增删改/一键导入内置全部/导入本地角色 .md）",
  "keywords": [
    "cordis",
    "dsh",
    "dsh-plugin",
    "prompt-engineering",
    "role-template",
    "ui"
  ],
  "homepage": "https://github.com/JayYuen666/dsh-dir-prep-organize#readme",
  "bugs": {
    "url": "https://github.com/JayYuen666/dsh-dir-prep-organize/issues"
  },
  "license": "MIT",
  "author": "JayYuen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayYuen666/dsh-dir-prep-organize.git"
  },
  "files": [
    "icon.svg",
    "host.js",
    "client.js",
    "templates.data.mjs",
    "types",
    "cordis.patch.yml",
    "agents",
    "locale/zh.json",
    "locale/en.json",
    "docs",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "sideEffects": [
    "./host.js",
    "./client.js",
    "./templates.data.mjs"
  ],
  "main": "host.js",
  "types": "./types/host.d.ts",
  "exports": {
    ".": {
      "types": "./types/host.d.ts",
      "default": "./host.js"
    },
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p src/tsconfig.json && tsc --noEmit -p tsconfig.build-scripts.json",
    "lint": "oxlint .",
    "test": "vitest run --coverage",
    "gen:defaults": "node scripts/gen-defaults.mjs",
    "check": "npm run --loglevel=warn typecheck && npm run --loglevel=warn lint && npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn build:types && npm run --loglevel=warn test && npm run --loglevel=warn fmt:check",
    "build:client": "node build-client.mjs",
    "build": "node build-host.mjs",
    "build:types": "node build-types.mjs",
    "prepack": "npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn build:types",
    "fmt:check": "oxfmt --check . --ignore-path .gitignore --ignore-path .prettierignore"
  },
